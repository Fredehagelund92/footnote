    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Tell the owner something is missing, wrong or unclear. Ask the person first. Use it when the person only knows an answer is missing, wrong or unclear, or that it helped; when you know the correct wording, write_draft then send_draft (after their yes) proposes the fix and is better. kind says what: missing, wrong, unclear, or helped. Pass the reply_id of the get_context reply it is about, and context_id when it is about one item; for something missing with no reply, pass the question's metrics, dimension values and dates instead. It records what was reported and where, so the owner of the domain sees it, and never who asked. The question is read in memory only. Never put question text, personal data or secrets in the optional short note.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "context_id": {
            "description": "The id of the item it is about, when it is about one.",
            "pattern": "^itm_[a-z0-9]{8,16}$",
            "type": "string",
          },
          "dimension_filters": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "dimension": {
                  "description": "A dimension by its name, or the member name you queried (view.member).",
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string",
                },
                "values": {
                  "items": {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string",
                  },
                  "maxItems": 50,
                  "type": "array",
                },
              },
              "required": [
                "dimension",
                "values",
              ],
              "type": "object",
            },
            "maxItems": 10,
            "type": "array",
          },
          "kind": {
            "description": "missing: something the person needs is not written down. wrong: an item says something that is not true. unclear: it is hard to read or to use. helped: it helped.",
            "enum": [
              "missing",
              "wrong",
              "unclear",
              "helped",
            ],
            "type": "string",
          },
          "metrics": {
            "description": "Metric names as people say them, their other names, or the member names you queried in the data tool (view.member, such as payments.orders).",
            "items": {
              "maxLength": 160,
              "minLength": 1,
              "type": "string",
            },
            "maxItems": 10,
            "type": "array",
          },
          "note": {
            "description": "A short note in the person's words, if they gave one. Never the question text, personal data or secrets.",
            "maxLength": 500,
            "minLength": 1,
            "type": "string",
          },
          "period": {
            "additionalProperties": false,
            "description": "The period in the person's own words, read as people write dates; period_read says the days. Pass window instead for exact days.",
            "properties": {
              "words": {
                "description": "The person's words for the period, as they wrote them, such as 'August last year'.",
                "maxLength": 120,
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "words",
            ],
            "type": "object",
          },
          "question": {
            "description": "For missing without a reply_id: the question, read in memory only for its metrics, dimension values and dates, never kept.",
            "maxLength": 2000,
            "type": "string",
          },
          "reply_id": {
            "description": "The reply_id of the get_context reply it is about.",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "window": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "type": "string",
              },
              "to": {
                "type": "string",
              },
            },
            "required": [
              "from",
              "to",
            ],
            "type": "object",
          },
        },
        "required": [
          "kind",
        ],
        "type": "object",
      },
      "name": "report",
      "outputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": {},
        "properties": {
          "next": {
            "description": "What to do next with this result: for you, not the person. When nothing was found, it says why that proves nothing and which call to make.",
            "minLength": 1,
            "type": "string",
          },
          "recorded": {
            "type": "boolean",
          },
          "say": {
            "description": "What you may tell the person about this result, in these words: plain sentences on what was read and what was found.",
            "minLength": 1,
            "type": "string",
          },
          "status": {
            "type": "string",
          },
          "to": {
            "description": "Who will see it, as a role: the owner of a domain.",
            "type": "string",
          },
        },
        "required": [
          "say",
          "status",
        ],
        "type": "object",
      },
      "title": "Tell the owner",
    },
    {
      "annotations": {
        "destructiveHint": false,
        "idempotentHint": false,
        "openWorldHint": false,
        "readOnlyHint": false,
      },
      "description": "Write or change a draft of the person's own. It is never sent. Use it to write context with the person: it saves a draft in Footnote that is theirs, and never sends it. When you know the correct wording for something missing or wrong, write_draft then send_draft (after their yes) proposes the fix; when the person only knows an answer is wrong, use report. Without draft_id it starts a new draft from text, a new item or, with item_id, a change to a published one, and gives back its draft_id, revision and link: give the person the link, where they can edit it too. Only what can be worked out is filled in, and every field is marked for the owner. With draft_id and the revision you last read, it changes only the fields you pass, one value replacing another. The person may have edited the draft since: a field they changed after that revision keeps their words and comes back in conflicts with its value now, while the others change. So read it with read_draft first whenever the person may have edited it, and never write a field back as you remember it. You may suggest the kind, title, summary, body, where it applies, when it applies, where it comes from and what not to conclude. The domain, owner, review date, references and definition marks are worked out for you, the cause, risk level and audience take their defaults, and the mentions, who stated the effect, the stated effect, replaces and conflicts are never filled from what you pass. Pass the words and names: they're matched to the vocabulary, so never invent a metric key or a link, and give a date the person is unsure of only with window.uncertain. Don't include names of customers or staff, personal data, secrets, question text or a transcript: text that looks like personal data or a secret, and words that read like orders to an AI agent, are refused, on a change as on a new draft. If it lists possible duplicates, ask the person, then call again with item_id or new_item. For a law or a regulation, write an event: the window from the day it takes effect as its text says, evidence from the official text, and not_to_conclude saying that it is not legal advice and whether the measure is provisional. A draft that was sent can't be changed. Tell the person what you changed, and ask whether to send it: on their yes, call send_draft with this revision. To write context from a document, save each item as its own draft and send none: the person reviews them and publishes them together in Your drafts, in Footnote's Inbox. The person's agents may save 50 new drafts in 24 hours, with 50 waiting unsent, unless an admin set other numbers: each new draft's reply says in drafts how many wait and the most allowed, and past it nothing is saved. How to write a draft: The summary is what agents read first: at most 280 characters, in plain words, saying what happened, where and when, so that it stands alone. Detail, caveats and what the item does not mean go in the body and in what not to conclude, never in the summary. Claim no cause unless the source states one. Name metrics and dimension values as the person does: the product matches their names to its own, so never invent a key. When the person is unsure of the date or gives none, draft anyway with your best start date, flag the dates as uncertain and say what you assumed; ask only for what you cannot fill. One fact per item: two things that happened are two items.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "area": {
            "description": "The domain, only when the person chose one after a reply asked.",
            "maxLength": 100,
            "minLength": 1,
            "type": "string",
          },
          "draft_id": {
            "description": "The draft to change, as write_draft or read_draft gave it. Leave out to start one.",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string",
          },
          "evidence": {
            "description": "Each source the person gave or you read: the address of the exact page, and one sentence copied character for character from that page in the page's own language, never a translation, a summary or a search snippet. Prefer the official text, such as a law on a government site, to a news report of it. Never invent one: if you only saw a summary of a page, leave it out and say so. When the person says it is written nowhere a link opens, such as a decision they made or what they know, pass said_by instead: who or what says so, in their words. Never make up a link.",
            "items": {
              "anyOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "quote": {
                      "maxLength": 500,
                      "minLength": 1,
                      "type": "string",
                    },
                    "url": {
                      "maxLength": 2000,
                      "type": "string",
                    },
                  },
                  "required": [
                    "url",
                    "quote",
                  ],
                  "type": "object",
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "said_by": {
                      "description": "One line that says who or what says so, and when, such as "Pricing committee, 20 August 2026".",
                      "maxLength": 500,
                      "minLength": 1,
                      "type": "string",
                    },
                  },
                  "required": [
                    "said_by",
                  ],
                  "type": "object",
                },
              ],
            },
            "maxItems": 5,
            "type": "array",
          },
          "item_id": {
            "description": "For a new draft, to change this published item instead of starting a new one.",
            "pattern": "^itm_[a-z0-9]{8,16}$",
            "type": "string",
          },
          "kind": {
            "description": "event: something that happened on a day. issue: a data problem that lasts a while. note: a lasting remark. guide: how to investigate. example: a checked answer to a question.",
            "enum": [
              "note",
              "event",
              "guide",
              "issue",
            ],
            "type": "string",
          },
          "new_item": {
            "description": "true when the person said it is new after a reply listed possible duplicates.",
            "type": "boolean",
          },
          "not_to_conclude": {
            "description": "What not to conclude from this, in the person's words, if they said. Otherwise "cause not proven" is used.",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
          "revision": {
            "description": "With draft_id, the revision you last read. A field the person changed after it keeps their words.",
            "maximum": 9007199254740991,
            "minimum": 1,
            "type": "integer",
          },
          "scope": {
            "additionalProperties": false,
            "description": "Names, as in your last get_context call. They're matched to the vocabulary.",
            "properties": {
              "dimension_filters": {
                "description": "Dimensions and the values it applies to, such as Norway for market or Email for channel. No values means every value.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "dimension": {
                      "description": "A dimension by its name, or the member name you queried (view.member).",
                      "maxLength": 160,
                      "minLength": 1,
                      "type": "string",
                    },
                    "values": {
                      "items": {
                        "maxLength": 160,
                        "minLength": 1,
                        "type": "string",
                      },
                      "maxItems": 50,
                      "type": "array",
                    },
                  },
                  "required": [
                    "dimension",
                    "values",
                  ],
                  "type": "object",
                },
                "maxItems": 10,
                "type": "array",
              },
              "metrics": {
                "description": "Metric names, as you used them with get_context.",
                "items": {
                  "maxLength": 160,
                  "minLength": 1,
                  "type": "string",
                },
                "maxItems": 10,
                "type": "array",
              },
            },
            "type": "object",
          },
          "summary": {
            "description": "One or two sentences an agent reads first, at most 280 characters. Do not claim a cause.",
            "maxLength": 280,
            "minLength": 1,
            "type": "string",
          },
          "text": {
            "description": "For a new draft, what the person wants recorded: what happened, where and since when; its first sentences become the summary when you give none. For a draft you change, its text: the detail under the summary. Not a transcript.",
            "maxLength": 2000,
            "minLength": 1,
            "type": "string",
          },
          "title": {
            "description": "A short title, if you have one.",
            "maxLength": 200,
            "minLength": 1,
            "type": "string",
          },
          "window": {
            "additionalProperties": false,
            "description": "Inclusive UTC dates the person named or that the source gives. When they are unsure, give your best start with uncertain: true. Leave out to when it is open.",
            "properties": {
              "from": {
                "type": "string",
              },
              "to": {
                "type": "string",
              },
              "uncertain": {
                "description": "True when the person is unsure of the dates: from is your best guess, and the owner sees the dates flagged.",
                "type": "boolean",
              },
            },
            "required": [
              "from",
            ],
            "type": "object",
          },
        },
        "type": "object",
      },
