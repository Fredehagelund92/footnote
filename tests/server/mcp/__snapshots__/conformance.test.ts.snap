      "description": "The metrics, dimensions and terms in Definitions, a page at a time. Use it to see what is defined or to pick some, never to answer a question (call get_context) or to search by words (call find_context).",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "cursor": {
            "description": "The next_cursor of the page before, for the next page.",
            "maxLength": 2000,
            "type": "string",
