              "url": {
                "description": "Its page in Definitions, for the person.",
                "type": "string",
              },
              "words": {
                "description": "What it means, whole: its source's own words, a family's meaning, or what a person wrote for a term. Null when nothing says.",
                "type": [
                  "string",
                  "null",
                ],
              },
              "words_from": {
                "description": "Where the words come from, in a sentence: say it with them.",
                "type": "string",
              },
              "written": {
                "additionalProperties": false,
                "description": "For a term: who wrote it, as a role, and when.",
