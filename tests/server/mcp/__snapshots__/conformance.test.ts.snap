                "conflicts_with",
                "applies_to",
                "mentions",
                "mentioned_by",
                "in_area",
              ],
              "type": "string",
            },
            "maxItems": 7,
            "minItems": 1,
            "type": "array",
          },
        },
        "required": [
          "id",
        ],
        "type": "object",
      },
