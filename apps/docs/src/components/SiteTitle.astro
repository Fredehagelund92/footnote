---
import lockup from '../../../../src/web/public/footnote-lockup.svg?raw'
import { DEFAULT_PRODUCT_NAME } from '../../../../src/domain/brand.ts'
import { readSettings } from '../../lib/settings.ts'

/* As the app's docs header: the logo, a hairline, then "Docs". A renamed build shows its name. */
const { product } = readSettings(process.env)
---

<a href={Astro.locals.starlightRoute.siteTitleHref} class="footnote-title">
  {product === DEFAULT_PRODUCT_NAME ? <Fragment set:html={lockup} /> : <span>{product}</span>}
  <span class="footnote-title-rule" aria-hidden="true"></span>
  <span class="footnote-title-docs">Docs</span>
</a>
