---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro'
import { shownGroups, sitePages } from '../../lib/pages.ts'
import { readSettings } from '../../lib/settings.ts'
import loopDark from '../../../docs/images/docs/loop-dark.svg?url'
import loopLight from '../../../docs/images/docs/loop-light.svg?url'
import whereDark from '../../../docs/images/docs/where-it-sits-dark.svg?url'
import whereLight from '../../../docs/images/docs/where-it-sits-light.svg?url'

/*
  The docs' home: what the product is, in the README's words, the way in for a newcomer, a door for
  each kind of reader, two diagrams of how it works and where it sits, then every page by its group.
  Each diagram has a file for each theme (docs/help/README.md, "Pictures"), and the theme shows one.
*/
const pages = sitePages()
const { product } = readSettings(process.env)
const path = (slug: string) => {
  if (!pages.some((page) => page.slug === slug)) throw new Error(`The docs have no page "${slug}".`)
  return `${import.meta.env.BASE_URL}${slug}/`
}
const changes = pages.filter((page) => !page.group)
const diagrams = [
  {
    light: loopLight,
    dark: loopDark,
    width: 960,
    height: 304,
    alt: 'The loop. A person writes down why a number moved. The owner checks and publishes it. An agent asks with get_context and reads what applies, and the answer starts with its line, such as Checked. When nothing is written, the answer says Not found, and the question comes back to the owner as a card in the Inbox, under Nothing written yet.',
  },
  {
    light: whereLight,
    dark: whereDark,
    width: 960,
    height: 360,
    alt: `Where ${product} sits. Cube or dbt define the metrics and dimensions, and ${product} reads their names. Documents in Google Drive or Git become suggestions for their owners. ${product} holds context items, each with an owner and a check date, and the names, but no data rows. Agents ask over MCP and read what applies; people write, check and ask in the web app.`,
  },
]
const line = 'What it is, where to start, and every page: writing context, agents, and running it.'
const doors = [
  {
    who: 'I own numbers',
    slug: 'write-context',
    what: 'Write down why a number moved, and check what others suggest.',
  },
  {
    who: 'I ask questions',
    slug: 'ask-a-question',
    what: 'Ask about a number, and read the line its answer starts with.',
  },
  {
    who: 'I connect an agent',
    slug: 'connect-an-agent',
    what: 'One prompt for Claude, Cursor or another agent, and the tools it calls.',
  },
  {
    who: 'I run it',
    slug: 'where-to-run',
    what: 'Where to run it, how to install it, back it up and upgrade it.',
  },
]
---

<StarlightPage
  frontmatter={{
    title: 'Documentation',
    line,
    description: line,
    reviewed: new Date(),
    lastUpdated: false,
    tableOfContents: false,
    pagefind: false,
  }}
>
  <p class="footnote-lead">
    {product} is where the people who know why a number moved write it down, and the owner of that
    part of the business checks it. When someone asks an AI agent about the number, the answer says
    who checked it and when. When nothing is written down, the answer says so instead of guessing.
  </p>
  <p class="footnote-start">
    <a class="btn btn-main" href={path('try-the-demo')}>Try the demo</a>
    <span>On your own computer, with Docker. The first start can take ten minutes.</span>
  </p>
  <nav class="footnote-doors" aria-label="Where to start">
    {
      doors.map((door) => (
        <a href={path(door.slug)}>
          <strong>{door.who}</strong>
          <span>{door.what}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </a>
      ))
    }
  </nav>
  {
    diagrams.map((diagram) => (
      <figure class="footnote-picture">
        <img
          class="dark:sl-hidden"
          src={diagram.light}
          alt={diagram.alt}
          width={diagram.width}
          height={diagram.height}
          loading="lazy"
        />
        <img
          class="light:sl-hidden"
          src={diagram.dark}
          alt={diagram.alt}
          width={diagram.width}
          height={diagram.height}
          loading="lazy"
        />
      </figure>
    ))
  }
  {
    shownGroups(pages).map((group) => (
      <section class="footnote-group">
        <h2>{group}</h2>
        <ul>
          {pages
            .filter((page) => page.group === group)
            .map((page) => (
              <li>
                <a href={path(page.slug)}>{page.title}</a>
                <span>{page.line}</span>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
  <section class="footnote-group">
    <h2>Changes</h2>
    <ul>
      {
        changes.map((page) => (
          <li>
            <a href={path(page.slug)}>{page.title}</a>
            <span>{page.line}</span>
          </li>
        ))
      }
    </ul>
  </section>
</StarlightPage>
