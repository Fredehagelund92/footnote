---
/* The ground's moving part (shared/ground.ts), on the 404 page: marks land on the paper around the
   sheet. A phone shows no paper beside the page, so nothing lands there. */
---

<script>
  import { ground } from './ground.ts'

  const gap = 28

  ground({
    areas: () => {
      const sheet = document.querySelector('.sheet')?.getBoundingClientRect()
      if (!sheet) return []
      return [
        { left: 0, top: 0, right: sheet.left - gap, bottom: innerHeight },
        { left: sheet.right + gap, top: 0, right: innerWidth, bottom: innerHeight },
      ]
    },
    every: [2600, 4800],
    strength: 0.55,
  })
</script>
