---
/* The ground's moving part (shared/ground.ts), on the 404 page: marks land on the dot field beside
   the page's words. A phone shows no ground beside them, so nothing lands there. */
---

<script>
  import { ground } from './ground.ts'

  const gap = 28

  ground({
    areas: () => {
      const words = document.querySelector('.lost h1')?.getBoundingClientRect()
      if (!words) return []
      return [
        { left: 0, top: 0, right: words.left - gap, bottom: innerHeight },
        { left: words.right + gap, top: 0, right: innerWidth, bottom: innerHeight },
      ]
    },
    every: [2600, 4800],
    strength: 0.55,
  })
</script>
