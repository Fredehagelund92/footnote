---
import { siteLinks } from '../lib/site.ts'
import { readSettings } from '../lib/settings.ts'
import { released } from '../landing/release.ts'
import Brand from './Brand.astro'

/* The footer, the same on the landing page and under every page of the docs. */
interface Props {
  /** Where the logo goes: the top of the landing page, or the landing page from the docs. */
  home: string
  /** Where Docs goes: the newest release's docs, or the home of the version being read. */
  docs: string
}

const { repository, repo } = siteLinks(readSettings(process.env))
---

<footer class="foot">
  <Brand href={Astro.props.home} />
  <nav class="foot-links" aria-label="Footer">
    <a href={Astro.props.docs}>Docs</a>
    <a href={repository}>GitHub</a>
    {released && <a href={`${repository}/releases`}>Releases</a>}
    <a href={`${repository}/issues`}>Issues</a>
    <a href={repo('LICENSE')}>Apache-2.0</a>
  </nav>
  <span>Pre-1.0, so expect changes.</span>
</footer>
