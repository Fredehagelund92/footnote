---
import { siteLinks } from '../../lib/site.ts'
import { readSettings } from '../../lib/settings.ts'
import Brand from '../../shared/Brand.astro'
import ThemeToggle from '../../shared/ThemeToggle.astro'

/* The landing page's header: the logo, the page's own parts, Docs and GitHub, the theme, and Run
   the demo. It stays at the top, over the page, blurred. */
const { docs, repository } = siteLinks(readSettings(process.env))
---

<header class="top">
  <div class="wrap">
    <Brand href="#top" />
    <nav class="nav" aria-label="Main">
      <a href="#loop">How it works</a>
      <a href="#lines">Answers</a>
      <a href="#agents">Agents</a>
      <a href={docs()}>Docs</a>
      <a href={repository}>GitHub</a>
    </nav>
    <div class="top-end">
      <ThemeToggle />
      <a class="btn btn-main btn-sm" href="#run">Run the demo</a>
    </div>
  </div>
</header>
