---
import { siteLinks } from '../../lib/site.ts'
import { readSettings } from '../../lib/settings.ts'
import Brand from '../../shared/Brand.astro'
import ThemeToggle from '../../shared/ThemeToggle.astro'

/* The header of the landing page and the 404 page: the logo, the landing page's own parts where it
   is the page, Docs and GitHub, the theme, and Run the demo. It stays at the top, over the page,
   blurred. */
interface Props {
  /** Where the logo goes: the top of this page, or the landing page. */
  home: string
  /** Where Run the demo goes: the steps on the landing page. */
  run: string
  /** The landing page's own parts, which only its own header names. */
  parts?: boolean
}

const { docs, repository } = siteLinks(readSettings(process.env))
---

<header class="top">
  <div class="wrap">
    <Brand href={Astro.props.home} />
    <nav class="nav" aria-label="Main">
      {
        Astro.props.parts && (
          <Fragment>
            <a href="#loop">How it works</a>
            <a href="#lines">Answer lines</a>
            <a href="#agents">Agents</a>
          </Fragment>
        )
      }
      <a href={docs()}>Docs</a>
      <a href={repository}>GitHub</a>
    </nav>
    <div class="top-end">
      <ThemeToggle />
      <a class="btn btn-main btn-sm" href={Astro.props.run}>Run the demo</a>
    </div>
  </div>
</header>
