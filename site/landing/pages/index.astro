---
import '../../shared/fonts.css'
import '../styles/app-font.css'
import '../../shared/tokens.css'
import '../../shared/chrome.css'
import '../../shared/ground.css'
import '../styles/landing.css'
import { siteLinks } from '../../lib/site.ts'
import { readSettings } from '../../lib/settings.ts'
import Ground from '../../shared/Ground.astro'
import SiteFooter from '../../shared/SiteFooter.astro'
import Head from '../components/Head.astro'
import Header from '../components/Header.astro'

/*
  The landing page, as approved (site/README.md, "The landing page"). Its claims carry footnotes
  that cite the test or file holding them, at this build's reference. The product pictures are
  real captures of the demo, taken by scripts/capture.ts.
*/

const { docs, repo } = siteLinks(readSettings(process.env))
const captures = import.meta.glob<{ src: string }>('../captures/*.webp', {
  eager: true,
  import: 'default',
})
const shot = (name: string) => {
  const found = captures[`../captures/${name}.webp`]
  if (!found) throw new Error(`No capture ${name}: run scripts/capture.ts.`)
  return found.src
}
