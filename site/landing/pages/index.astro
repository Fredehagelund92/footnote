---
import '../../shared/fonts.css'
import '../../shared/tokens.css'
import '../../shared/chrome.css'
import '../styles/landing.css'
import { siteLinks } from '../../lib/site.ts'
import { readSettings } from '../../lib/settings.ts'
import SiteFooter from '../../shared/SiteFooter.astro'
import Head from '../components/Head.astro'
import Header from '../components/Header.astro'
import { releaseWords } from '../release.ts'

/*
  The landing page, "Two readers", as approved (site/README.md, "The landing page"): paper for
  people, a terminal for agents, and the note on the seam between them. The three replies of the
  first screen are get_context's on the demo, word for word, and the pictures are real captures of
  the demo, taken by scripts/capture.ts.
*/

// The release switch: false until the first release's images can be pulled. It is the one line to
// change at the release (landing/release.ts says what changes, and what to check first).
const released = false

const words = releaseWords(released)
const { docs } = siteLinks(readSettings(process.env))
const captures = import.meta.glob<{ src: string }>('../captures/*.webp', {
  eager: true,
  import: 'default',
})
const shot = (name: string) => {
  const found = captures[`../captures/${name}.webp`]
  if (!found) throw new Error(`No capture ${name}: run scripts/capture.ts.`)
  return found.src
}
---

<html lang="en">
  <head>
    <Head
      title="Footnote"
      description="Footnote: write down why a number moved, have the owner check it, and every AI agent reads it before it answers. Open source, self-hosted, pre-1.0."
    />
    <script is:inline>
      // The opening plays only with motion allowed, and the page never stays hidden: if the
      // script that plays it has not started in five seconds, the finished state shows.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.classList.add('anim')
        setTimeout(function () {
          var hero = document.querySelector('.hero')
          if (hero && !hero.classList.contains('play')) hero.classList.add('done')
        }, 5000)
      }
    </script>
  </head>
