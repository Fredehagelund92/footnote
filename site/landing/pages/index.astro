---
import '../../shared/tokens.css'
import '../../shared/fonts.css'
import '../styles/base.css'
import '../../shared/chrome.css'
import '../styles/landing.css'
import inter from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url'
import { siteLinks } from '../../lib/site.ts'
import { readSettings } from '../../lib/settings.ts'
import SiteFooter from '../../shared/SiteFooter.astro'
import AskWindow from '../components/AskWindow.astro'
import Definitions from '../components/Definitions.astro'
import Head from '../components/Head.astro'
import Header from '../components/Header.astro'
import Said from '../components/Said.astro'
import Sprite from '../components/Sprite.astro'
import { released, releaseWords } from '../release.ts'
import * as meaning from '../meaning.ts'
// The tour's screens: two of the landing page's own captures and three of the docs' pictures, all
// taken by scripts/capture.ts.
import itemLight from '../captures/item-light.webp'
import itemDark from '../captures/item-dark.webp'
import observabilityLight from '../captures/observability-light.webp'
import observabilityDark from '../captures/observability-dark.webp'
import inboxLight from '../../../docs/images/docs/inbox-light.webp'
import inboxDark from '../../../docs/images/docs/inbox-dark.webp'
import askLight from '../../../docs/images/docs/ask-answer-light.webp'
import askDark from '../../../docs/images/docs/ask-answer-dark.webp'
import compareLight from '../../../docs/images/docs/compare-light.webp'
import compareDark from '../../../docs/images/docs/compare-dark.webp'

/*
  The landing page, "Ask this page", as approved (site/README.md, "The landing page"): dark, on
  Footnote's dot field, with the vision told one sentence a section. The first screen is a question
  about the demo company answered from a note a named person wrote and its owner checked
  (landing/demo.ts, landing/hero.ts). The pictures are real captures of the demo, taken by
  scripts/capture.ts.
*/

const words = releaseWords(released)
const { docs, repository } = siteLinks(readSettings(process.env))

/* The tour: one real screen of the app per step, in light and dark. */
const tour = [
  {
    light: itemLight,
    dark: itemDark,
    title: 'Someone writes it down',
    text: 'A note says what happened, where and from when. It quotes its source and names its owner and its check date.',
    alt: 'A context item on the demo: Online sales to Norway stopped on 4 August 2026, with the sentence copied from the customs notice, its domain, owners, check date and source link.',
  },
  {
    light: inboxLight,
    dark: inboxDark,
    title: 'Its owner checks it',
    text: "It lands in its owner's Inbox. They see what agents say today and what they would say after, then publish it or send it back.",
    alt: 'The Inbox on the demo: a suggestion to change a context item, with what agents say today beside what they would say after it is published.',
  },
  {
    light: askLight,
    dark: askDark,
    title: 'Anyone asks',
    text: 'Ask is the page for people. The answer starts with how far to trust it, says what is written, and names the note it used.',
    alt: 'Ask on the demo: a question about units sold in Norway, answered with the line Checked, what is written, and the item it used.',
  },
  {
    light: compareLight,
    dark: compareDark,
    title: 'Two notes disagree',
    text: 'Agents get both and say so. An owner keeps one, narrows one, or keeps both.',
    alt: 'The conflict view on the demo: two context items about orders in France that say different things, side by side, with what agents would say with each.',
  },
  {
    light: observabilityLight,
    dark: observabilityDark,
    title: 'What nobody wrote comes back',
    text: 'Observability shows what agents asked about and which questions found nothing. It keeps counts, not the words.',
    alt: 'Observability on the demo: what agents asked this week, by topic and answer line, with the share of checked answers and the questions that found nothing. Counts only.',
  },
]
const opening = tour[0]!

/* Meaning, not numbers: the week the scrubber opens on, as it is drawn before any script runs. */
const shown = meaning.week(meaning.opening)
const point = meaning.at(meaning.opening)

const headline = 'Tell your AI agents why the number moved before they'.split(' ')
---

<html lang="en">
  <head>
    <Head
      title="Footnote. Tell your AI agents why the number moved"
      description="Footnote is where your team writes down why a number moved. The owner checks it, and your connected AI agents read it before they answer. Open source, self-hosted, pre-1.0."
      fonts={[inter]}
    />
    <script is:inline>
      // The page arrives and plays only with motion allowed, and never stays hidden: if its script
      // has not started in five seconds, the page shows as it is with reduced motion.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const root = document.documentElement
        root.classList.add('anim')
        setTimeout(function () {
          if (!root.classList.contains('live')) root.classList.remove('anim')
        }, 5000)
      }
    </script>
  </head>
  <body>
    <Sprite />
    <Header home="#top" run="#run" parts />

    <main id="top">
      <section class="hero" id="hero" aria-labelledby="h-hero">
        <div class="wrap">
          <h1 id="h-hero">
            {headline.map((word, i) => <Fragment><span class="w" style={`--i:${i}`}>{word}</span>{' '}</Fragment>)}<span class="w" style={`--i:${headline.length}`}>guess</span>
          </h1>
          <div class="hero-row">
            <div>
              <p class="sub">Your team writes down why a number moved, and the owner checks it. A connected AI agent reads it before it answers. Its answer carries a footnote: who checked it, and when.</p>
              <div class="cta"><a class="btn btn-main" href="#run">Run the demo</a><a class="btn btn-line" href={docs()}>Read the docs</a></div>
              <p class="need">Runs on your computer with Docker.</p>
            </div>
            <p class="status"><i class={released ? 'dot' : 'dot none'}></i><b>{words.status}</b><a href={`${repository}#readme`}>What is true today</a></p>
          </div>

          <div class="stage">
            <AskWindow />
          </div>
          <p class="win-cap">An example from the demo company that comes with Footnote. The company and the people are invented.</p>
          <div class="hero-end"></div>
        </div>
      </section>

      <section class="sec" id="why" aria-label="What Footnote is for">
        <div class="wrap">
          <p class="state-big rv" id="state"><b>Ask an AI agent why orders in Norway fell and it may guess.</b> With Footnote, it answers from what your team wrote down and the owner checked.</p>
          <ol class="trio">
            <li class="rv">
              <div class="frag" aria-hidden="true">
                <div class="row a1"><span class="chipx">Orders</span><span class="chipx">Netherlands</span><span class="chipx">13 Feb to 24 Sep 2026</span></div>
                <div class="year"><i class="span"></i><i class="q a2" style="--x:45.8%" data-l="June: told"></i><i class="q out a3" style="--x:87.5%" data-l="November: not told"></i></div>
              </div>
              <h2>A note covers one place and one stretch of time</h2>
              <p>A market that closed for a month, or a report that arrived a day late. Each note names its dates and its place, and agents get it only for a question about those. In the app, a note is called a context item.</p>
            </li>
            <li class="rv" style="--d:120ms">
              <div class="frag" aria-hidden="true">
                <div class="row"><span class="swap"><span class="badge was"><svg class="ic"><use href="#i-check"></use></svg>Checked</span><span class="badge b-old now"><svg class="ic"><use href="#i-old"></use></svg>Outdated</span></span><i class="due"></i><span class="a3" style="--t:1400ms">check date passed</span></div>
                <div class="row a3" style="--t:1700ms"><span class="pill">Still true</span><span class="pill">Edit</span></div>
              </div>
              <h2>Old notes carry a warning</h2>
              <p>A note can have an end date, and agents stop getting it after that date. Most notes also have a check date. Past it, agents are told the note may be out of date until its owner looks again.</p>
            </li>
            <li class="rv" style="--d:240ms">
              <div class="frag" aria-hidden="true">
                <div class="row a1"><s class="struck">This may reflect weaker marketing performance.</s></div>
                <div class="row a3"><span class="badge b-missing"><svg class="ic"><use href="#i-none"></use></svg>Not found</span><span>nothing is written down</span></div>
              </div>
              <h2>If nothing is written, the answer says so</h2>
              <p>The answer is Not found, and your agent is told so in plain words. A question that keeps finding nothing goes to the owner, so someone can write it down.</p>
            </li>
          </ol>
        </div>
      </section>

      <section class="sec" id="loop" aria-labelledby="h-loop">
        <div class="wrap">
          <div class="sec-head rv">
            <h2 id="h-loop">Anyone can suggest a note. The owner decides what agents read</h2>
            <p>Your agent can suggest one too. Nothing reaches an agent without its owner's yes.</p>
          </div>
          <div class="tour rv" id="tour" style="--d:120ms">
            <div class="tour-tabs" role="tablist" aria-label="Screens of the app">
              {
                tour.map((step) => (
                  <button
                    type="button"
                    role="tab"
                    aria-selected={step === opening ? 'true' : 'false'}
                    tabindex={step === opening ? undefined : '-1'}
                    aria-controls="shot"
                    data-light={step.light.src}
                    data-dark={step.dark.src}
                    data-alt={step.alt}
                  >
                    <b>{step.title}</b>
                    <span>{step.text}</span>
                  </button>
                ))
              }
            </div>
            <figure>
              <div class="shot glow" id="shot" role="tabpanel" aria-label="The screen">
                <i class="gl" aria-hidden="true"></i>
                <div class="pic">
                  <img class="on-light" src={opening.light.src} width={opening.light.width} height={opening.light.height} loading="lazy" alt={opening.alt} />
                  <img class="on-dark" src={opening.dark.src} width={opening.dark.width} height={opening.dark.height} loading="lazy" alt={opening.alt} />
                </div>
              </div>
              <figcaption class="cap">Real screens of the app. The names on them are invented.</figcaption>
            </figure>
          </div>
        </div>
      </section>

      <section class="sec" id="said" aria-labelledby="h-said">
        <div class="wrap">
          <div class="sec-head rv">
            <h2 id="h-said">What someone already said becomes a note</h2>
            <p>The reason a number moved is often in a chat thread already. Paste it into Footnote, or hand it to your agent, and it becomes your draft. Nothing reaches an answer until the owner checks it.</p>
          </div>
          <Said />
        </div>
      </section>

      <section class="sec" id="meaning" aria-labelledby="h-meaning">
        <div class="wrap">
          <div class="sec-head rv">
            <h2 id="h-meaning">The figure comes from your metrics tool. The reason comes from Footnote</h2>
            <p>Orders in Norway fell to almost nothing in August. Your metrics tool (a semantic layer, such as Cube or dbt) defines Orders and returns that figure. Footnote holds why it fell, and from when.</p>
          </div>
          <div class="sb glow rv" id="sb" style="--d:120ms">
            <i class="gl" aria-hidden="true"></i>
            <div class="sb-q">
              <p><span class="sb-k">Asked</span>What happened to orders in Norway in the week of <b class="sb-date">{shown.day}</b>?</p>
              <span class="sb-hint" aria-hidden="true"><svg viewBox="0 0 24 12"><path d="M5 2 1 6l4 4M19 2l4 4-4 4M1 6h22"></path></svg>Drag along the line</span>
            </div>
            <div class="sb-chart">
              <div class="sb-band" style={`left:${meaning.from * 100}%`} aria-hidden="true"><span class="sb-band-l"><span class="ref">1</span><span class="sb-long">applies&nbsp;</span>from 4 Aug<span class="sb-long">&nbsp;2026</span></span></div>
              <svg class="sb-svg" viewBox="0 0 1000 1000" preserveAspectRatio="none" aria-hidden="true"><path class="sb-line" d={meaning.path}></path></svg>
              <div class="sb-cur" style={`left:${point.x * 100}%`} aria-hidden="true"><span class="sb-flag">{shown.day.replace(/ \d{4}$/, '')}</span><i class="sb-pt" style={`top:${point.y * 100}%`}></i></div>
              <input class="sb-range" type="range" min="0" max={meaning.last} step="1" value={meaning.opening} aria-label="The week asked about" aria-valuetext={`Week of ${shown.day}`} aria-describedby="sb-line" />
              <p class="sr-only" id="sb-line">{meaning.described}</p>
            </div>
            <div class="sb-months" aria-hidden="true">
              {meaning.months.map((m) => <span class:list={[{ wide: !m.narrow }]} style={`left:${m.x * 100}%`}>{m.label}</span>)}
            </div>
            <div class="sb-cols">
              <div class="sb-col">
                <p class="sb-k"><svg aria-hidden="true"><use href="#l-cube"></use></svg>The figure, from Cube</p>
                <p class="sb-move">{shown.move}</p>
                <p class="sb-cap">The figure stays in Cube, and your agent reads it there. Footnote never reads it, and keeps none.</p>
              </div>
              <div class="sb-col">
                <p class="sb-k"><svg aria-hidden="true"><use href="#i-logo"></use></svg>Footnote matches</p>
                <ul class="sb-rules">
                  <li class="ok"><i class="sb-tick" aria-hidden="true"></i><span>Metric</span><b>Orders</b></li>
                  <li class="ok"><i class="sb-tick" aria-hidden="true"></i><span>Market</span><b>Norway</b></li>
                  <li class:list={['sb-dates', { ok: shown.applies }]}><i class="sb-tick" aria-hidden="true"></i><span>Dates</span><b class="sb-dtext">{shown.dates}</b></li>
                </ul>
                <div class="sb-res">
                  <div class="sb-hit" hidden={!shown.applies}>
                    <span class="badge"><svg class="ic" aria-hidden="true"><use href="#i-check"></use></svg>Checked</span>
                    <p class="sb-title"><span class="ref">1</span>{meaning.note.title}</p>
                    <p class="sb-who">Written by {meaning.note.writer}. Checked by {meaning.note.checker}, {meaning.note.checkedOn}.</p>
                  </div>
                  <div class="sb-miss" hidden={shown.applies}>
                    <span class="badge b-missing"><svg class="ic" aria-hidden="true"><use href="#i-none"></use></svg>Not found</span>
                    <p class="sb-who">Nothing is written about Orders in Norway for that week.</p>
                  </div>
                </div>
              </div>
              <div class="sb-col">
                <p class="sb-k">Your agent says</p>
                <p class="sb-says">{shown.says}{shown.applies && <span class="ref" role="img" aria-label="Footnote 1">1</span>}</p>
              </div>
            </div>
            <p class="sr-only" id="sb-live" aria-live="polite"></p>
          </div>
          <p class="small">No model picks the note. These three plain rules match the question's metric, values and dates against what's written.</p>
        </div>
      </section>

      <section class="sec" id="definitions" aria-labelledby="h-def">
        <div class="wrap">
          <div class="sec-head rv">
            <h2 id="h-def">Each metric, with the notes people wrote about it</h2>
            <p>Definitions shows the metrics and dimensions your semantic layer defines, such as Orders and Market. Footnote only reads them.</p>
          </div>
          <Definitions />
        </div>
      </section>

      <section class="sec" id="lines" aria-labelledby="h-lines">
        <div class="wrap">
          <div class="sec-head rv">
            <h2 id="h-lines">Every answer starts by saying how far to trust it</h2>
            <p>That first line is one of six, in Ask and for agents. Plain code sets it from the notes found, never a model, so Checked means the same thing every time.</p>
          </div>
          <ul class="lines">
            <li class="rv" style="--d:0ms"><span class="badge"><svg class="ic" aria-hidden="true"><use href="#i-check"></use></svg>Checked</span><p>Something applies, and its owner published it with a source and a check date.</p><p>Nothing to do.</p></li>
            <li class="rv" style="--d:60ms"><span class="badge b-partial"><svg class="ic" aria-hidden="true"><use href="#i-part"></use></svg>Partial</span><p>Part of the question is covered, or the dates were assumed. The answer says which.</p><p>Write the rest, or tell the owner.</p></li>
            <li class="rv" style="--d:120ms"><span class="badge b-missing"><svg class="ic" aria-hidden="true"><use href="#i-none"></use></svg>Not found</span><p>Nobody has written this down. That's not the same as there being no reason.</p><p>Write it, or tell the owner.</p></li>
            <li class="rv" style="--d:180ms"><span class="badge b-conflict"><svg class="ic" aria-hidden="true"><use href="#i-conflict"></use></svg>Conflict</span><p>Two items apply and they disagree. Agents get both and say so.</p><p>An owner keeps one, narrows one, or keeps both.</p></li>
            <li class="rv" style="--d:240ms"><span class="badge b-old"><svg class="ic" aria-hidden="true"><use href="#i-old"></use></svg>Outdated</span><p>The check date has passed, or a definition the item relies on changed.</p><p>The owner looks again: Still true, or Edit.</p></li>
            <li class="rv" style="--d:300ms"><span class="badge b-failed"><svg class="ic" aria-hidden="true"><use href="#i-off"></use></svg>Not looked up</span><p>Ask couldn't look just now. It doesn't mean nothing is written.</p><p>Try again in a minute.</p></li>
          </ul>
        </div>
      </section>

      <section class="sec" id="agents" aria-labelledby="h-agents">
        <div class="wrap">
          <div class="sec-head rv">
            <h2 id="h-agents">Your agent asks Footnote before it answers</h2>
            <p>It connects over MCP, the way agents reach other tools, and signs in as you. One line in your AGENTS.md tells it to ask first. It gets the first line, then each note that applies, with its source.</p>
          </div>
          <div class="agents-grid">
            <div>
              <div class="term glow rv" id="term">
                <i class="gl" aria-hidden="true"></i>
                <p class="q ln" style="--i:0">How did orders in Norway change in October 2026?</p>
                <p class="ln" style="--i:1">called <b>get_context</b></p>
                <p class="ln" style="--i:2"><span class="k">"status":</span> <span class="v">"matched"</span></p>
                <p class="ln" style="--i:3"><span class="k">"say":</span> <span class="v">"<span class="st">Checked.</span> 5 context items apply to Orders in Norway in October 2026. Nothing else was looked up. 1 of them applies to only part of that question."</span></p>
                <p class="ln" style="--i:4"><span class="k">"title":</span> <span class="v">"Online sales to Norway stopped on 4 August 2026"</span></p>
                <p class="ln" style="--i:5;margin-bottom:20px"><span class="k">"not_to_conclude":</span> <span class="v">"Fewer orders in Norway after 4 August do not mean fewer customers."</span></p>
                <p class="says ln" style="--i:8"><small>the agent then says</small>Orders in Norway fell because online sales there stopped on 4 August 2026 under a new customs rule. Jon Abara, who owns Sales, checked that on 3 Oct 2026. It does not mean there are fewer customers.</p>
              </div>
              <p class="cap">What Footnote sends the agent, shortened. The last lines are an example of what the agent then says.</p>
            </div>
            <div>
              <h3>One line in your AGENTS.md</h3>
              <p class="term one"><span class="c"># Footnote</span><br />Before you answer a question about a company metric, call get_context first and use what it returns.</p>
              <h3 class="then">Seven tools</h3>
              <ul class="rows">
                <li><code>get_context</code><span>the notes that apply, answer line first</span></li>
                <li><code>find_context</code><span>what's written about a few words</span></li>
                <li><code>read_context</code><span>one note or definition in full</span></li>
                <li><code>report</code><span>tell the owner it looks wrong, after you say yes</span></li>
                <li><code>write_draft</code><span>write a draft with you, never sent</span></li>
                <li><code>read_draft</code><span>read your draft back as you left it</span></li>
                <li><code>send_draft</code><span>send your draft, after you say yes</span></li>
              </ul>
            </div>
          </div>
          <div class="reads-grid rv">
            <div>
              <h3>What reads it</h3>
              <ul class="rows">
                <li><b><svg aria-hidden="true"><use href="#l-claude"></use></svg>Claude Code</b><span class="tag"><i class="dot"></i>tried</span></li>
                <li><b><svg aria-hidden="true"><use href="#l-cursor"></use></svg>Cursor</b><span class="tag"><i class="dot none"></i>install link, not tried</span></li>
                <li><b><svg aria-hidden="true"><use href="#l-vscode"></use></svg>VS Code</b><span class="tag"><i class="dot none"></i>install link, not tried</span></li>
                <li><b><svg aria-hidden="true"><use href="#l-openai"></use></svg>ChatGPT and Codex</b><span class="tag"><i class="dot none"></i>written steps, not tried</span></li>
                <li><b><svg aria-hidden="true"><use href="#l-mcp"></use></svg>Any other MCP client</b><span class="tag"><i class="dot none"></i>over HTTP, not tried</span></li>
              </ul>
            </div>
            <div>
              <h3>What it reads</h3>
              <ul class="rows">
                <li><b><svg aria-hidden="true"><use href="#l-cube"></use></svg>Cube</b><span class="tag"><i class="dot"></i>works today</span></li>
                <li><b><svg aria-hidden="true"><use href="#l-dbt"></use></svg>dbt MetricFlow</b><span class="tag"><i class="dot"></i>works today</span></li>
                <li><b><svg aria-hidden="true"><use href="#l-markdown"></use></svg>Markdown in Git</b><span class="tag"><i class="dot part"></i>{words.markdownStatus}</span></li>
                <li><b><svg aria-hidden="true"><use href="#l-drive"></use></svg>Google Drive</b><span class="tag"><i class="dot part"></i>built, not tried on a real account</span></li>
                <li><b><svg aria-hidden="true"><use href="#l-notion"></use></svg>Notion</b><span class="tag"><i class="dot none"></i>designed, not built</span></li>
              </ul>
            </div>
          </div>
          <p class="small">Footnote reads the names of your metrics and dimensions from Cube or dbt. A document from Google Drive or Git arrives as a suggestion, and its owner decides whether to publish it. <a href={docs('connectors')}>Connectors</a>, <a href={docs('connect-an-agent')}>Connect an agent</a></p>
        </div>
      </section>

      <section class="sec" id="run" aria-labelledby="h-run">
        <div class="wrap">
          <div class="sec-head rv">
            <h2 id="h-run">Run the demo on your own computer</h2>
            <p>{words.installLede}</p>
          </div>
          <ol class="go">
            <li class="rv" style="--d:0ms"><h3>Start it</h3><p>{words.startLine}</p><p class="cmd">{words.startCommands.map((command, i) => <Fragment>{i > 0 && <br />}<span>$ </span>{command}</Fragment>)}</p></li>
            <li class="rv" style="--d:80ms"><h3>Open it</h3><p>Open Ask and try the Norway question. The answer is marked Checked and puts the customs rule first.</p><p class="cmd"><span>$ </span>open http://localhost:8080</p></li>
            <li class="rv" style="--d:160ms"><h3>Connect Claude Code</h3><p>Add the server, run /mcp, pick it and choose Authenticate. Pick a demo person and press Allow.</p><p class="cmd"><span>$ </span>claude mcp add --transport http footnote http://localhost:3000/mcp</p></li>
          </ol>
          <ul class="true rv">
            <li>On the demo nothing leaves your computer, and no AI service is called.</li>
            <li>From agents, Footnote keeps only what a question was about, and how often. Never the words, and never who asked.</li>
            <li>{words.versionNote}</li>
          </ul>
        </div>
      </section>

      <section class="sec close" aria-labelledby="h-close">
        <div class="wrap rv">
          <h2 id="h-close">{words.closeTitle} <b>Try the demo on your computer</b></h2>
          <div class="cta"><a class="btn btn-main" href={docs('try-the-demo')}>Run the demo</a><a class="btn btn-line" href={docs()}>Read the docs</a></div>
          <p>Open source under Apache-2.0</p>
        </div>
      </section>

    </main>

    <SiteFooter home="#top" docs={docs()} />

    <script>
      import { hero } from '../hero.ts'
      import { page } from '../page.ts'

      document.documentElement.classList.add('live')
      hero(document.querySelector<HTMLElement>('#hero')!)
      page()
    </script>
  </body>
</html>
