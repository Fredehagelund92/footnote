<script is:inline>
(function () {
  // A tab list: arrow keys, Home and End move between tabs; the panel shows with a short fade.
  function tablist(tabs, onShow) {
    function select(tab, focus) {
      tabs.forEach(function (t) {
        var on = t === tab;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        var panel = document.getElementById(t.getAttribute('aria-controls'));
        panel.hidden = !on;
        if (on && onShow) onShow(panel);
      });
      if (focus) tab.focus();
    }
    tabs.forEach(function (t, i) {
      t.addEventListener('click', function () { select(t, false); });
      t.addEventListener('keydown', function (e) {
        var k = e.key, n = null;
        if (k === 'ArrowDown' || k === 'ArrowRight') n = tabs[(i + 1) % tabs.length];
        if (k === 'ArrowUp' || k === 'ArrowLeft') n = tabs[(i - 1 + tabs.length) % tabs.length];
        if (k === 'Home') n = tabs[0];
        if (k === 'End') n = tabs[tabs.length - 1];
        if (n) { e.preventDefault(); select(n, true); }
      });
    });
  }
  var all = function (sel) { return Array.prototype.slice.call(document.querySelectorAll(sel)); };
  tablist(all('.a-chat'), function (panel) {
    var ans = panel.querySelector('.a-answer');
    ans.classList.remove('in'); void ans.offsetWidth; ans.classList.add('in');
  });


  // How it fits: draw the wires between the cards, again whenever the layout changes. Side by
  // side they run from one card's edge to the next; stacked on a phone they run down the middle.
  var dg = document.getElementById('dg');
  if (dg) {
    var NS = 'http://www.w3.org/2000/svg', wires = dg.querySelector('.dg-wires');
    var W = [
      { from: 'note', to: 'core', k: 'a' },
      { from: 'defs', to: 'core', k: 'b', cls: 'dots', around: true },
      { from: 'core', to: 'readers', k: 'c' },
      { from: 'readers', to: 'ans', k: 'd' }
    ];
    var node = function (n) { return dg.querySelector('[data-node="' + n + '"]'); };
    var el = function (tag, cls) { var e = document.createElementNS(NS, tag); e.setAttribute('class', cls); wires.appendChild(e); return e; };
    // The paths are made once and only reshaped later, so the light keeps its place in the cycle.
    W.forEach(function (w) {
      w.base = el('path', 'dg-base ' + (w.cls || ''));
      w.beam = el('path', 'dg-beam ' + w.k); w.beam.setAttribute('pathLength', '1');
      w.end = el('path', 'dg-end');
    });
    // Wires run in straight lines with rounded bends, and end in a small arrowhead.
    var R = 10, n = function (v) { return Math.round(v * 10) / 10; };
    var across = function (x1, y1, x2, y2) {
      var m = (x1 + x2) / 2, dy = y2 - y1, s = dy < 0 ? -1 : 1, r = Math.min(R, Math.abs(dy) / 2, Math.abs(m - x1));
      if (Math.abs(dy) < 1) return 'M' + n(x1) + ' ' + n(y1) + 'H' + n(x2);
      return 'M' + n(x1) + ' ' + n(y1) + 'H' + n(m - r) + 'Q' + n(m) + ' ' + n(y1) + ' ' + n(m) + ' ' + n(y1 + s * r) +
        'V' + n(y2 - s * r) + 'Q' + n(m) + ' ' + n(y2) + ' ' + n(m + r) + ' ' + n(y2) + 'H' + n(x2);
    };
    var down = function (x1, y1, x2, y2) {
      var m = (y1 + y2) / 2, dx = x2 - x1, s = dx < 0 ? -1 : 1, r = Math.min(R, Math.abs(dx) / 2, (y2 - y1) / 2);
      if (Math.abs(dx) < 1) return 'M' + n(x1) + ' ' + n(y1) + 'V' + n(y2);
      return 'M' + n(x1) + ' ' + n(y1) + 'V' + n(m - r) + 'Q' + n(x1) + ' ' + n(m) + ' ' + n(x1 + s * r) + ' ' + n(m) +
        'H' + n(x2 - s * r) + 'Q' + n(x2) + ' ' + n(m) + ' ' + n(x2) + ' ' + n(m + r) + 'V' + n(y2);
    };
    var round = function (x1, y1, x2, y2, b) {
      return 'M' + n(x1) + ' ' + n(y1) + 'H' + n(b - R) + 'Q' + n(b) + ' ' + n(y1) + ' ' + n(b) + ' ' + n(y1 + R) +
        'V' + n(y2 - R) + 'Q' + n(b) + ' ' + n(y2) + ' ' + n(b - R) + ' ' + n(y2) + 'H' + n(x2);
    };
    var head = function (x, y, dir) {
      var k = { right: [-6, -4, -6, 4], left: [6, -4, 6, 4], down: [-4, -6, 4, -6] }[dir];
      return 'M' + n(x + k[0]) + ' ' + n(y + k[1]) + 'L' + n(x) + ' ' + n(y) + 'L' + n(x + k[2]) + ' ' + n(y + k[3]);
    };
    var draw = function () {
      var o = dg.getBoundingClientRect();
      W.forEach(function (w) {
        var a = node(w.from).getBoundingClientRect(), b = node(w.to).getBoundingClientRect(), d, h;
        var ax = a.left - o.left, ay = a.top - o.top, bx = b.left - o.left, by = b.top - o.top;
        if (bx >= ax + a.width - 1) {
          var y2 = by + b.height / 2;
          d = across(ax + a.width, ay + a.height / 2, bx - 2, y2); h = head(bx - 2, y2, 'right');
        } else if (w.around) {
          var r2 = bx + b.width, yy2 = by + 24;
          d = round(ax + a.width, ay + a.height / 2, r2 + 2, yy2, Math.max(ax + a.width, r2) + 18); h = head(r2 + 2, yy2, 'left');
        } else {
          var cx2 = bx + b.width / 2;
          d = down(ax + a.width / 2, ay + a.height, cx2, by - 2); h = head(cx2, by - 2, 'down');
        }
        w.base.setAttribute('d', d); w.beam.setAttribute('d', d); w.end.setAttribute('d', h);
      });
    };
    draw();
    if ('ResizeObserver' in window) new ResizeObserver(draw).observe(dg);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(draw);
    if ('IntersectionObserver' in window) {
      dg.classList.add('off');
      new IntersectionObserver(function (es) { es.forEach(function (e) { dg.classList.toggle('off', !e.isIntersecting); }); }).observe(dg);
    }
  }

  // Copy buttons.
  document.querySelectorAll('.copy').forEach(function (b) {
    b.addEventListener('click', function () {
      var text = b.getAttribute('data-copy');
      var done = function () {
        b.classList.add('done'); b.innerHTML = '<svg><use href="#i-done"/></svg>';
        setTimeout(function () { b.classList.remove('done'); b.innerHTML = '<svg><use href="#i-copy"/></svg>'; }, 1400);
      };
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, function () {});
    });
  });

  // The hero plays once, when its fonts are in, so the strike lands on the final line breaks.
  var hero = document.querySelector('.hero');
  var play = function () { hero.classList.add('play'); };
  if (document.fonts && document.fonts.ready) Promise.race([document.fonts.ready, new Promise(function (r) { setTimeout(r, 1200); })]).then(play);
  else play();
})();
</script>
