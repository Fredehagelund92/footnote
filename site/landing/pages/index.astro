<div class="cmdw"><button class="copy" type="button" aria-label="Copy the command" data-copy="claude mcp add --transport http footnote http://localhost:3000/mcp"><svg><use href="#i-copy"/></svg></button><pre class="cmd"><span class="p">$ </span>claude mcp add --transport http footnote http://localhost:3000/mcp</pre></div>
          </div>
