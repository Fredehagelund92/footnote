---
import '../styles/not-found.css'
import { siteLinks } from '../../lib/site.ts'
import { readSettings } from '../../lib/settings.ts'
import Ground from '../../shared/Ground.astro'
import SiteFooter from '../../shared/SiteFooter.astro'
import Head from '../components/Head.astro'
import Header from '../components/Header.astro'
import inter from '@fontsource-variable/inter/files/inter-latin-opsz-normal.woff2?url'

/* The page a wrong address anywhere on the site opens, in the site's design: the landing page's
   closing screen, with the answer line an agent gives when nothing is written. */
const { docs, home } = siteLinks(readSettings(process.env))
---

<html lang="en">
  <head>
    <Head
      title="Not found - Footnote"
      description="This address leads to no page of Footnote's site."
      fonts={[inter]}
    />
  </head>
  <body>
    <Header home={home} run={`${home}#run`} />
    <main class="lost" aria-labelledby="h-missing">
      <div class="wrap">
        <h1 id="h-missing"><span>Not found</span> <b>There is no page at this address</b></h1>
        <div class="cta">
          <a class="btn btn-main" href={home}>Go to the start</a>
          <a class="btn btn-line" href={docs()}>Read the docs</a>
        </div>
        <p>It may have moved, or the link has a typo.</p>
      </div>
    </main>
    <SiteFooter home={home} docs={docs()} />
    <Ground />
  </body>
</html>
