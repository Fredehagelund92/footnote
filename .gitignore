node_modules/
dist/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
.DS_Store
.env
.env.*
!.env.example
.tanstack/
# What `vercel link` and `vercel build` write (docs/vercel.md).
.vercel/

# The keys the service makes outside production (.footnote-dev-key.pem and the rest), and any
# other key file, whatever its name, are never committed.
*.pem
*.key

# A held-out key (npm run held-out -- keygen) is never committed.
*held-out*.key

# The private overlay: one deployment's own facts, settings and tests (docs/requirements.md,
# section 16). It is never committed.
/overlay/
